# BugArena MCP - API Keys Configuration
# Rename this file to `.env` or set these keys in ~/.gemini/config/mcp_config.json

# Google Gemini (Free API key available at https://aistudio.google.com/)
# GEMINI_API_KEY="your-gemini-api-key"

# OpenAI (https://platform.openai.com/)
# OPENAI_API_KEY="your-openai-api-key"

# DeepSeek (https://platform.deepseek.com/)
# DEEPSEEK_API_KEY="your-deepseek-api-key"

# Groq (Free API key available at https://console.groq.com/)
# GROQ_API_KEY="your-groq-api-key"
